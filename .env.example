# AYAZ MÜHENDİSLİK - Production Çevre Değişkenleri
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Alan Adı (Domain)
DOMAIN=ayazmuhendislik.com

# Opsiyonel: E-posta (SMTP) Bildirim Ayarları
# Teklif formundan gelen taleplerin doğrudan şirket mailine düşmesi için doldurabilirsiniz:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teklif@ayazmuhendislik.com
SMTP_PASS=uygulama_sifresi
NOTIFICATION_EMAIL=info@ayazmuhendislik.com

# Opsiyonel: Kurumsal WhatsApp Keşif Numarası
WHATSAPP_NUMBER=905000000000
